{
  "name": "kidsprogress",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "KidsProgress v2 — children's progress tracker",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.1.2",
  "scripts": {
    "build": "pnpm tokens:build && pnpm -r run build",
    "dev": "pnpm tokens:build && pnpm -r --parallel run dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\" --ignore-path .gitignore",
    "tokens:build": "tsx scripts/build-tokens.ts",
    "db:generate": "pnpm --filter @kidsprogress/db run generate",
    "db:migrate": "pnpm --filter @kidsprogress/db run migrate",
    "db:seed": "pnpm --filter @kidsprogress/db run seed",
    "api:dev": "pnpm --filter @kidsprogress/api run dev",
    "web:dev": "pnpm --filter @kidsprogress/web run dev",
    "check:migrations": "tsx scripts/check-migrations.ts",
    "rotate:jwt-secret": "tsx scripts/rotate-jwt-secret.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@kidsprogress/shared": "workspace:*",
    "@types/node": "^22.10.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
