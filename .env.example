# --- Application -------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
PORT=8000

# Comma-separated list of frontend origins allowed for CORS
CORS_ORIGINS=http://localhost:5173

# --- Database ----------------------------------------------------------------
# DB_DRIVER selects which Drizzle driver/dialect is used.
#   sqlite  : local file via better-sqlite3 (default for NAS deploy)
#   postgres: managed Postgres via pg (cloud-portable; e.g. Neon)
#   turso   : libSQL (SQLite-compatible, edge-replicated)
DB_DRIVER=sqlite
SQLITE_PATH=./data/kidsprogress.sqlite
# DATABASE_URL=postgres://user:pass@host:5432/kidsprogress
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=

# --- Auth --------------------------------------------------------------------
# REQUIRED. No fallback. App refuses to start if missing in production.
JWT_SECRET=change-me-in-dev-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# argon2id parameters (kept conservative for the Atom CPU on DS216+II)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME=2
ARGON2_PARALLELISM=1

# --- LLM (Gemini) ------------------------------------------------------------
# Required for chat / recommendations / scheduling features.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Per-child daily token cap. 0 disables the cap (not recommended).
GEMINI_DAILY_TOKENS_PER_CHILD=5000

# --- File storage ------------------------------------------------------------
# Where attachments live.
#   local : on-disk under UPLOADS_PATH (default; NAS volume)
#   s3    : S3-compatible (R2 / B2 / AWS S3) — cloud-portable
UPLOAD_STORE=local
UPLOADS_PATH=./data/uploads
UPLOAD_MAX_BYTES=26214400
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Web client (build-time, prefixed VITE_) ---------------------------------
# Public values only. Never put secrets behind VITE_*.
VITE_API_BASE_URL=http://localhost:8000
